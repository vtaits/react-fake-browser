{
  "type": "module",
  "name": "@vtaits/react-router-dom-v5-fake-browser",
  "version": "1.0.0",
  "description": "Embeddable fake browser for react applications based on react-router-dom version 5",
  "files": [
    "dist",
    "src",
    "!src/__stories__",
    "!src/**/*.test.js",
    "!src/**/*.test.jsx"
  ],
  "main": "./src/index.js",
  "module": "./src/index.js",
  "typings": "dist/ts/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "keywords": [
    "fake",
    "browser",
    "embeddable",
    "react-router"
  ],
  "repository": "git@github.com:vtaits/react-fake-browser.git",
  "author": "Vadim Taits <taizvadim@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:ts": "tsc",
    "lint": "biome check src",
    "lint:fix": "biome check src --write --unsafe",
    "test:unit": "vitest run --coverage.enabled --coverage.all --coverage.include=src --coverage.exclude=src/__stories__",
    "test:unit:watch": "vitest",
    "test": "yarn lint && yarn test:ts && yarn test:unit",
    "prepare": "yarn build"
  },
  "peerDependencies": {
    "@vtaits/react-fake-browser-ui": "^1.0.0",
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-router-dom": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vtaits/react-fake-browser-ui": "^1.0.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-router-dom": "^5.3.4",
    "vitest": "^5.0.5"
  }
}
